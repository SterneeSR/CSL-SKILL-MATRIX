datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  password_hash        String
  role                 String              @default("STUDENT") // STUDENT | TUTOR | ADMIN
  account_status       String              @default("PENDING") // PENDING | ACTIVE | REJECTED
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  profile              StudentProfile?
  evaluations          Evaluation[]
  evaluation_histories EvaluationHistory[]
  created_activities   Activity[]

  @@map("users")
}

model StudentProfile {
  id                  String                     @id @default(uuid())
  user_id             String                     @unique
  first_name          String
  last_name           String
  student_identifier  String                     @unique
  batch_id            String?
  approved_at         DateTime?
  rejected_at         DateTime?
  rejection_reason    String?
  user                User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  batch               Batch?                     @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  submissions         Submission[]
  sub_skill_scores    StudentSubSkillScore[]
  skill_scores        StudentSkillScore[]
  overall_performance StudentOverallPerformance?
  skill_evidences     SkillEvidence[]

  @@map("student_profiles")
}

model Course {
  id              String                @id @default(uuid())
  code            String                @unique
  title           String
  description     String?
  created_at      DateTime              @default(now())
  batches         Batch[]
  required_skills CourseRequiredSkill[]
  activities      Activity[]

  @@map("courses")
}

model Batch {
  id         String           @id @default(uuid())
  course_id  String
  name       String
  start_date DateTime
  end_date   DateTime
  course     Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  students   StudentProfile[]

  @@map("batches")
}

model SkillCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  skills      Skill[]

  @@map("skill_categories")
}

model Skill {
  id               String                @id @default(uuid())
  category_id      String
  name             String
  description      String?
  category         SkillCategory         @relation(fields: [category_id], references: [id], onDelete: Cascade)
  sub_skills       SubSkill[]
  required_courses CourseRequiredSkill[]
  student_scores   StudentSkillScore[]

  @@unique([category_id, name])
  @@map("skills")
}

model SubSkill {
  id             String                 @id @default(uuid())
  skill_id       String
  name           String
  description    String?
  skill          Skill                  @relation(fields: [skill_id], references: [id], onDelete: Cascade)
  activities     Activity[]
  student_scores StudentSubSkillScore[]
  evidences      SkillEvidence[]

  @@unique([skill_id, name])
  @@map("sub_skills")
}

model CourseRequiredSkill {
  id          String  @id @default(uuid())
  course_id   String
  skill_id    String
  is_required Boolean @default(true)
  course      Course  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  skill       Skill   @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([course_id, skill_id])
  @@map("course_required_skills")
}

model Activity {
  id                  String       @id @default(uuid())
  course_id           String
  sub_skill_id        String
  title               String
  instructions        String
  activity_type       String // ASSESSMENT | TASK | PROJECT
  max_marks           Int
  is_max_marks_locked Boolean      @default(false)
  deadline            DateTime
  is_reopened         Boolean      @default(false)
  reopened_deadline   DateTime?
  created_by_id       String?
  created_at          DateTime     @default(now())
  course              Course       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  sub_skill           SubSkill     @relation(fields: [sub_skill_id], references: [id], onDelete: Cascade)
  created_by          User?        @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  submissions         Submission[]

  @@map("activities")
}

model Submission {
  id                     String         @id @default(uuid())
  activity_id            String
  student_id             String
  submission_url_or_file String?
  notes                  String?
  withdrawal_count       Int            @default(0)
  submission_status      String         @default("SUBMITTED") // SUBMITTED | WITHDRAWN | FAILED
  submitted_at           DateTime       @default(now())
  withdrawn_at           DateTime?
  activity               Activity       @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  student                StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  evaluation             Evaluation?

  @@unique([activity_id, student_id])
  @@map("submissions")
}

model Evaluation {
  id                  String              @id @default(uuid())
  submission_id       String              @unique
  tutor_id            String
  obtained_marks      Int
  percentage          Float
  feedback            String?
  tutor_re_eval_count Int                 @default(0)
  evaluation_status   String              @default("EVALUATED") // EVALUATED | RE_EVALUATED | ESCALATED_TO_ADMIN
  evaluated_at        DateTime            @default(now())
  submission          Submission          @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  tutor               User                @relation(fields: [tutor_id], references: [id], onDelete: Cascade)
  history             EvaluationHistory[]
  evidences           SkillEvidence[]

  @@map("evaluations")
}

model EvaluationHistory {
  id             String     @id @default(uuid())
  evaluation_id  String
  evaluator_id   String
  evaluator_role String // TUTOR | ADMIN
  previous_marks Int
  new_marks      Int
  reason         String
  recorded_at    DateTime   @default(now())
  evaluation     Evaluation @relation(fields: [evaluation_id], references: [id], onDelete: Cascade)
  evaluator      User       @relation(fields: [evaluator_id], references: [id], onDelete: Cascade)

  @@map("evaluation_histories")
}

model SkillEvidence {
  id                  String                 @id @default(uuid())
  student_id          String
  sub_skill_id        String
  evaluation_id       String
  normalized_score    Float
  validity_expires_at DateTime?
  is_expired          Boolean                @default(false)
  recorded_at         DateTime               @default(now())
  student             StudentProfile         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  sub_skill           SubSkill               @relation(fields: [sub_skill_id], references: [id], onDelete: Cascade)
  evaluation          Evaluation             @relation(fields: [evaluation_id], references: [id], onDelete: Cascade)
  sub_skill_scores    StudentSubSkillScore[]

  @@map("skill_evidences")
}

model StudentSubSkillScore {
  id                 String         @id @default(uuid())
  student_id         String
  sub_skill_id       String
  latest_evidence_id String?
  current_score      Float
  updated_at         DateTime       @updatedAt
  student            StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  sub_skill          SubSkill       @relation(fields: [sub_skill_id], references: [id], onDelete: Cascade)
  latest_evidence    SkillEvidence? @relation(fields: [latest_evidence_id], references: [id], onDelete: SetNull)

  @@unique([student_id, sub_skill_id])
  @@map("student_sub_skill_scores")
}

model StudentSkillScore {
  id                String         @id @default(uuid())
  student_id        String
  skill_id          String
  current_score     Float
  proficiency_level String // FOUNDATIONAL | DEVELOPING | PROFICIENT | ADVANCED
  status            String // PROVISIONAL | COMPLETE
  updated_at        DateTime       @updatedAt
  student           StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  skill             Skill          @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([student_id, skill_id])
  @@map("student_skill_scores")
}

model StudentOverallPerformance {
  id                    String         @id @default(uuid())
  student_id            String         @unique
  current_overall_score Float
  status                String // NOT_COMPLETE | COMPLETE
  achieved_at           DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  student               StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("student_overall_performances")
}
